import { writeFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { format, resolveConfig } from 'prettier'
import { profile } from '../src/content/profile.ts'
import { projects } from '../src/content/projects.ts'
import { githubContent } from '../profile-readme/content.ts'
import { findHiddenTerms, localHiddenTerms } from './lib/hidden-terms.mts'

export async function renderGithubReadme(): Promise<string> {
  const { identity } = profile
  const rows = githubContent.selected.map((slug) => {
    if (slug === 'personal-website') {
      return `| [personal-website](${identity.github}/personal-website) | This site: shared facts, case studies and an on-demand guide. | [Site](${identity.website}) |`
    }
    const project = projects.find((entry) => entry.slug === slug)
    if (!project) throw new Error(`Unknown selected project: ${slug}`)
    const source =
      project.visibility === 'public-repo'
        ? project.facts.links.find((link) => link.label === 'Source code')?.href
        : undefined
    const title = source
      ? `[${project.title}](${source})`
      : `${project.title} (source private; audit pending)`
    return `| ${title} | ${project.description} | [Notes](${identity.website}/projects/${slug}) |`
  })
  const tech = githubContent.tech.map((pick) => {
    const group = profile.skills.find((entry) => entry.label === pick.label)
    if (!group || pick.items.some((item) => !group.items.includes(item))) {
      throw new Error(`Unknown skills in ${pick.label}`)
    }
    return `- **${pick.label}:** ${pick.items.join(', ')}`
  })
  const output =
    [
      '<!-- Generated by pnpm readme. Edit profile-readme/content.ts and shared facts. -->',
      `# ${identity.name}`,
      `${identity.title} at ${identity.company}. ${githubContent.role}`,
      `[Website](${identity.website}) · [Resume](${identity.website}/eduard-kakosyan-resume.pdf) · [LinkedIn](${identity.linkedin}) · [Email](mailto:${identity.email})`,
      '## Now',
      githubContent.now.map((line) => `- ${line}`).join('\n'),
      '## Selected work',
      ['| Project | What to inspect | Context |', '| --- | --- | --- |', ...rows].join('\n'),
      '## Tech',
      tech.join('\n'),
      `The code is here; the decisions and my contribution are at [${identity.website.replace('https://', '')}](${identity.website}/projects).`,
    ].join('\n\n') + '\n'
  if (findHiddenTerms(output, [...profile.hidden, ...localHiddenTerms()]).length) {
    throw new Error('Generated README contains a hidden term; output not written')
  }
  // Match the commit hook so formatting cannot make the generated artifact stale.
  const filepath = fileURLToPath(new URL('../profile-readme/README.md', import.meta.url))
  return format(output, { ...(await resolveConfig(filepath)), filepath })
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  writeFileSync(new URL('../profile-readme/README.md', import.meta.url), await renderGithubReadme())
}
